{
  "name": "stock-fundflow-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node dev-server.js",
    "test": "node --test test/*.test.js",
    "test:ci": "node --test --test-concurrency=1 test/*.test.js",
    "build": "vite build",
    "package:fc": "node scripts/build-fc-package.mjs",
    "preview": "vite preview",
    "start": "node server.js",
    "migrate:oss": "node scripts/migrate-blob-to-oss.mjs",
    "harness": "node harness/run.mjs",
    "harness:ci": "node harness/run.mjs --output-dir harness-artifacts",
    "harness:portfolio": "node harness/run.mjs --suite portfolio",
    "harness:execution": "node harness/run.mjs --suite execution",
    "harness:lifecycle": "node harness/run.mjs --suite decision-lifecycle --no-baseline",
    "harness:sector": "node harness/run.mjs --suite sector",
    "evaluate:lifecycle": "node scripts/run-decision-lifecycle-evaluation.mjs && python3 scripts/generate-decision-lifecycle-report.py",
    "harness:export": "node harness/export.mjs",
    "harness:online": "node harness/run.mjs --suite endpoint --online --no-baseline",
    "harness:shadow": "node harness/run.mjs --suite shadow --online --no-baseline",
    "harness:advice": "node scripts/advice-reliability-harness.mjs",
    "opportunity:export": "node scripts/export-opportunity-outcomes.mjs",
    "opportunity:backfill-stockdb": "node --max-old-space-size=6144 scripts/backfill-opportunity-stockdb.mjs",
    "opportunity:backfill-tushare": "node --max-old-space-size=6144 scripts/backfill-opportunity-stockdb.mjs --provider tushare",
    "opportunity:replay-archive": "node --max-old-space-size=6144 scripts/backfill-opportunity-stockdb.mjs --provider archive",
    "opportunity:archive-tushare": "python3 qlib-service/publish_tushare_market_history.py",
    "opportunity:archive-daily": "python3 qlib-service/archive_public_market_day.py",
    "opportunity:archive-tushare-daily": "python3 qlib-service/archive_tushare_market_day.py",
    "opportunity:migrate-v5": "node --max-old-space-size=6144 scripts/migrate-opportunity-history-v5.mjs",
    "decision:dataset": "cd qlib-service && python3 -m decision_engine.training.datasets --input opportunity-outcomes.json --output opportunity-dataset.npz",
    "decision:bakeoff": "cd qlib-service && python3 -m decision_engine.training.ensemble_evaluation --input opportunity-outcomes.json --output-dir opportunity-model/seed-ensemble",
    "decision:train": "cd qlib-service && python3 -m decision_engine.training.ensemble --dataset opportunity-dataset.npz --output opportunity-model --poc-report opportunity-model/seed-ensemble/report.json",
    "decision:release": "cd qlib-service && python3 -m decision_engine.training.release --dataset opportunity-dataset.npz --champion opportunity-model/champion --challenger opportunity-model/shadow --output opportunity-model/release --decision-output opportunity-model/release_decision.json",
    "backtest": "node backtest/run.mjs"
  },
  "dependencies": {
    "@alicloud/fc20230330": "^4.7.9",
    "@alicloud/openapi-core": "^1.0.8",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@vercel/blob": "^2.6.1",
    "ali-oss": "^6.23.0",
    "echarts": "6.1.0",
    "echarts-for-react": "3.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.5",
    "vite": "8.2.1"
  }
}
