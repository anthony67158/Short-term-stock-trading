{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.tedixtf.cn/contracts/strategy-spec.v2.schema.json",
  "title": "StrategySpec v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "strategyId",
    "name",
    "family",
    "purpose",
    "horizon",
    "eligibleRegimes",
    "signalTimeframe",
    "executionTimeframe",
    "data",
    "entry",
    "exit",
    "trailingStop",
    "positionSizing",
    "riskLimits",
    "liquidityLimits",
    "benchmark",
    "capacityAssumptions",
    "modelDependencies",
    "execution",
    "score",
    "specVersion"
  ],
  "properties": {
    "schemaVersion": { "const": "strategy-spec.v2" },
    "strategyId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "family": {
      "enum": [
        "TREND_BREAKOUT",
        "CROSS_SECTIONAL_MOMENTUM",
        "RANGE_MEAN_REVERSION",
        "MULTI_FACTOR_RANKING",
        "DEFENSIVE_EXIT"
      ]
    },
    "purpose": {
      "enum": ["ENTRY", "RANKING", "POSITION_MANAGEMENT", "EXIT"]
    },
    "horizon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "value"],
      "properties": {
        "unit": { "enum": ["MINUTE", "TRADING_DAY"] },
        "value": { "type": "integer", "minimum": 1 }
      }
    },
    "eligibleRegimes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "TREND_STRONG",
          "RANGE",
          "TRANSITION",
          "RISK_OFF",
          "UNKNOWN"
        ]
      }
    },
    "signalTimeframe": { "enum": ["1d", "5m"] },
    "executionTimeframe": { "enum": ["NEXT_OPEN", "NEXT_BAR_OPEN"] },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signalPrice",
        "executionPrice",
        "pointInTime",
        "completedBarsOnly",
        "minimumHistoryBars"
      ],
      "properties": {
        "signalPrice": { "const": "QFQ" },
        "executionPrice": { "const": "RAW" },
        "pointInTime": { "const": true },
        "completedBarsOnly": { "const": true },
        "minimumHistoryBars": { "type": "integer", "minimum": 1 }
      }
    },
    "entry": { "$ref": "#/$defs/condition" },
    "exit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stopLossPct",
        "takeProfitPct",
        "maxHoldingBars",
        "signal"
      ],
      "properties": {
        "stopLossPct": { "type": "number", "exclusiveMinimum": 0 },
        "takeProfitPct": { "type": "number", "exclusiveMinimum": 0 },
        "maxHoldingBars": { "type": "integer", "minimum": 1 },
        "signal": {
          "anyOf": [
            { "$ref": "#/$defs/condition" },
            { "type": "null" }
          ]
        }
      }
    },
    "trailingStop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "activationPct", "atrMultiple"],
      "properties": {
        "enabled": { "type": "boolean" },
        "activationPct": { "type": "number", "minimum": 0 },
        "atrMultiple": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "positionSizing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "riskPerTradePct",
        "allocationPct",
        "maxPositions",
        "lotSize"
      ],
      "properties": {
        "method": { "enum": ["RISK_BUDGET", "EQUAL_WEIGHT"] },
        "riskPerTradePct": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2
        },
        "allocationPct": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "maxPositions": { "type": "integer", "minimum": 1 },
        "lotSize": { "type": "integer", "minimum": 1 }
      }
    },
    "riskLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxPortfolioExposurePct",
        "maxStockWeightPct",
        "maxSectorExposurePct",
        "maxLossPct",
        "allowRiskIncrease"
      ],
      "properties": {
        "maxPortfolioExposurePct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "maxStockWeightPct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "maxSectorExposurePct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "maxLossPct": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 20
        },
        "allowRiskIncrease": { "type": "boolean" }
      }
    },
    "liquidityLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimumAmount",
        "minimumAdv20",
        "maximumParticipationRate",
        "maximumSpreadBps"
      ],
      "properties": {
        "minimumAmount": { "type": "number", "exclusiveMinimum": 0 },
        "minimumAdv20": { "type": "number", "exclusiveMinimum": 0 },
        "maximumParticipationRate": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.2
        },
        "maximumSpreadBps": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "benchmark": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["CSI300", "CSI1000"] }
    },
    "capacityAssumptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capitalScenarios",
        "slippageScenariosBps",
        "baseParticipationRate"
      ],
      "properties": {
        "capitalScenarios": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "number", "exclusiveMinimum": 0 }
        },
        "slippageScenariosBps": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "number", "minimum": 0 }
        },
        "baseParticipationRate": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.2
        }
      }
    },
    "modelDependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "version", "required"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "enum": ["MODEL", "FACTOR_SET", "NONE"] },
          "version": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "featureCount": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feePolicy",
        "tPlusOne",
        "rejectLimitUpBuy",
        "rejectLimitDownSell",
        "carryUnfilledExit",
        "baseSlippageBps",
        "spreadBps"
      ],
      "properties": {
        "feePolicy": { "const": "A_SHARE_STANDARD_V1" },
        "tPlusOne": { "const": true },
        "rejectLimitUpBuy": { "const": true },
        "rejectLimitDownSell": { "const": true },
        "carryUnfilledExit": { "const": true },
        "baseSlippageBps": { "type": "number", "minimum": 0 },
        "spreadBps": { "type": "number", "minimum": 0 }
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "weights"],
      "properties": {
        "method": { "const": "WEIGHTED_SUM" },
        "weights": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "specVersion": {
      "type": "string",
      "pattern": "^strategy\\.[a-z0-9]+$"
    }
  },
  "$defs": {
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "conditions"],
          "properties": {
            "type": { "enum": ["ALL", "ANY"] },
            "conditions": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/condition" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["field", "op", "value"],
          "properties": {
            "field": { "type": "string", "minLength": 1 },
            "op": {
              "enum": ["BETWEEN", "EQ", "GT", "GTE", "IN", "LT", "LTE", "NE"]
            },
            "value": {}
          }
        }
      ]
    }
  }
}
