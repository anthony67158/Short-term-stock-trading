# ===== 阿里云 FC 3.0 + OSS 部署所需环境变量 =====
# 复制为 .env（本地迁移脚本用）或在 FC 控制台/ s.yaml 里配置。

# ---- 大模型（保持你现在的，不动）----
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
ADVISOR_MODEL=
AGENT_MODEL=
DAILY_MODEL=

# ---- 第三方数据 ----
FINNHUB_KEY=
QUANT_URL=
QUANT_KEY=

# ---- 阿里云 OSS（替代 Vercel Blob）----
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=你的数据桶名
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 可选：FC 与 OSS 同区时填内网 endpoint 省流量，如 oss-cn-hangzhou-internal.aliyuncs.com
OSS_ENDPOINT=
# 可选：绑定 CDN/自定义域名后的读取基址，如 https://data.example.com
OSS_PUBLIC_BASE=

# ---- Serverless Devs 上传代码包（本机网络访问全球加速端点不稳定时使用）----
FC_CODE_TEMP_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com

# ---- 仅数据迁移脚本用（迁完可删）----
# Vercel Blob 读写令牌（源数据）
BLOB_READ_WRITE_TOKEN=
