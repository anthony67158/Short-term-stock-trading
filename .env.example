# Copy to .env.local for local development.
# Never commit real credentials.

# OpenAI-compatible LLM gateway
LLM_BASE_URL=https://your-llm-gateway.example/v1
LLM_API_KEY=sk-example
ADVISOR_MODEL=DeepSeek-V4-Pro
PORTFOLIO_MODEL=DeepSeek-V4-Pro
AGENT_MODEL=Qwen3-Max-A
DAILY_MODEL=Qwen3-Max-A
SECTOR_MODEL=gpt-5.6-terra
JUDGE_MODEL=gemini-2.5-flash
EMBED_MODEL=BGE-m3

# Optional Doubao Global Search fallback. Runtime config is stored in OSS.
DOUBAO_SEARCH_API_KEY=
DOUBAO_SEARCH_KEY_NAME=stock

# Optional self-hosted SearXNG fallback. Public instances are not supported.
SEARXNG_ENABLED=false
SEARXNG_BASE_URL=

# Accounts allowed to use paid AI and V2 controls.
# Comma-separated sha256("u:" + nickname) hashes; never store nicknames here.
AUTHORIZED_ACCOUNT_HASHES=
# Accounts allowed to change shared LLM and Doubao Search runtime configuration.
RUNTIME_CONFIG_ADMIN_HASHES=

# Optional advisor council and strategy promotion controls
ADVISOR_COUNCIL_SHADOW=true
STRATEGY_APPROVAL_KEY=

# Production daily quant service
QUANT_URL=
QUANT_KEY=

# Optional V2/V2.1 EAS service
V2_QUANT_URL=
V2_EAS_TOKEN=
V2_API_KEY=

# Alibaba Cloud OSS
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=
OSS_ENDPOINT=https://oss-cn-hangzhou-internal.aliyuncs.com
OSS_ALLOW_PUBLIC_NETWORK=false
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# FC Timer and internal Worker authentication
CRON_KEY=

# Registered-domain device access. Store only the HMAC digest, never the code.
SITE_ACCESS_CODE_HMAC=

# Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Optional market data
FINNHUB_KEY=

# Frontend production build. Leave empty locally to use the Vite /api proxy.
VITE_API_BASE=

# One-time Vercel Blob to OSS migration only
BLOB_READ_WRITE_TOKEN=
