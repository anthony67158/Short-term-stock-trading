# ============ 环境变量示例 ============
# 复制本文件为 .env.local 并填入真实值（.env.local 已被 .gitignore 忽略，不会上传）

# —— LLM 大模型（AI 助手 / 做T建议 / 盘面复盘 必需）——
# 兼容 OpenAI 格式的网关地址与密钥
LLM_BASE_URL=https://your-llm-gateway/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_MODEL=your-chat-model              # 结构化 JSON 场景用的模型
AGENT_MODEL=your-function-calling-model # 支持 function calling 的模型（AI 助手 Agent 用）

# 允许调用付费 AI 与控制 V2 的账号标识哈希，多个用逗号分隔。
# 部署时根据现有账号昵称计算 sha256("u:"+nick)，不要填写昵称或密码。
AUTHORIZED_ACCOUNT_HASHES=

# 军师委员会默认影子开启；紧急关闭时设为 false。
ADVISOR_COUNCIL_SHADOW=true
# 策略其他晋级门禁全部通过后，人工批准仍需独立长随机密钥。
STRATEGY_APPROVAL_KEY=

# —— 云端账号 / 跨设备数据同步（可选，不配则账号功能不可用）——
# OSS 默认禁止公网访问；仅一次性迁移且明确接受流量费用时才临时设为 true。
OSS_ALLOW_PUBLIC_NETWORK=false
# Vercel Blob 读写令牌；本地可留空（账号功能需要）
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
