# Save as ~/.config/stock-platform/platform.env or set PLATFORM_CONFIG_FILE.
PLATFORM_ENVIRONMENT=local
PLATFORM_DATABASE_URL=postgresql+psycopg://platform:CHANGE_ME@127.0.0.1:55432/platform
PLATFORM_ORIGIN=http://localhost:5173
PLATFORM_COOKIE_SECURE=false
PLATFORM_WRITE_ENABLED=true
PLATFORM_DEPLOYMENT_REVISION=development
PLATFORM_WEB_DIST_ROOT=
PLATFORM_AGENT_BASE_URL=https://linlongs.com
PLATFORM_AGENT_MODEL=gpt-5.6-terra
PLATFORM_AGENT_API_KEY=
PLATFORM_AGENT_ENABLED=false
PLATFORM_AGENT_TIMEOUT_SECONDS=180
PLATFORM_AGENT_DAILY_CALL_LIMIT=20
PLATFORM_AGENT_GLOBAL_DAILY_CALL_LIMIT=100
PLATFORM_AGENT_SEARCH_MAX_CALLS=4
PLATFORM_SEARCH_ENABLED=false
PLATFORM_SEARCH_BASE_URL=https://open.feedcoopapi.com/search_api/web_search
PLATFORM_SEARCH_API_KEY=
PLATFORM_SEARCH_API_KEY_NAME=stock
PLATFORM_SEARCH_TIMEOUT_SECONDS=20
PLATFORM_SEARCH_RESULT_LIMIT=8
PLATFORM_MARKET_DATA_ENABLED=false
PLATFORM_MARKET_DATA_BASE_URL=https://ts.gyzcloud.top/api
PLATFORM_MARKET_DATA_API_KEY=
PLATFORM_MARKET_DATA_TIMEOUT_SECONDS=40
PLATFORM_JOINT_BUNDLE_ROOT=~/.local/share/stock-platform/joint-releases/active-shadow.json
PLATFORM_RANKING_DATASET_ROOT=~/.local/share/stock-platform/full-universe-ranking-v1
PLATFORM_MARKET_DATASET_ROOT=~/.local/share/stock-platform/a-share-20160101-20260915-v5
PLATFORM_RANKING_MODEL_ROOT=~/.local/share/stock-platform/full-universe-ranking-model-v1
PLATFORM_QUANT_MODEL_ROOT=~/.local/share/stock-platform/quant-short-horizon-enriched-v2
PLATFORM_POSITION_MODEL_ROOT=~/.local/share/stock-platform/position-action-model-v2
PLATFORM_ACCOUNT_BACKTEST_PATH=~/.local/share/stock-platform/quant-short-horizon-enriched-v2/account-backtest-v1.json
PLATFORM_JOINT_CANDIDATE_REGISTRY_ROOT=~/.local/share/stock-platform/joint-candidates
