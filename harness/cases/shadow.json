        "allowedCodes": ["600000"],
        "allowedEvidenceIds": ["E1"],
        "timeoutMs": 180000
      },
      "expect": {
        "minOverall": 0.9,
        "minResponses": 1,
        "minAgreement": 0.67,
        "maxLatencyMs": 180000,
        "maxTotalTokens": 50000
      }
    }
  ]
